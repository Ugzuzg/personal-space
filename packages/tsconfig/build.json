{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "include": ["${configDir}/src"],
  "exclude": [
    "${configDir}/vitest.config.ts",
    "${configDir}/**/__tests__/**",
    "${configDir}/**/*.test.*",
    "${configDir}/**/*.spec.*",
    "${configDir}/**/__snapshots__/**"
  ],
  "compilerOptions": {
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src"
  }
}
